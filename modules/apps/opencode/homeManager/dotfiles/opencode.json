{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      ".env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "ls *": "allow",
      "which *": "allow",
      "cat *": "allow",
      "curl *": "ask",
      "rm *": "deny",
      "rmdir *": "deny",
      "mv *": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "sudo *": "deny",
      ">": "deny",
      "| bash": "deny",
      "| sh": "deny",
      "| zsh": "deny",
      "install *": "deny"
    },
    "edit": "ask",
    "write": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "task": "ask",
    "external_directory": "deny",
    "doom_loop": "deny"
  }
}
